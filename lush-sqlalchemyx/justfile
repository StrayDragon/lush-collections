set shell := ["bash", "-euo", "pipefail", "-c"]

# Package `lush-sqlalchemyx` 的本地开发命令.
# 约定: Python 3.10+, 使用 uv 管理依赖/锁文件.

# `python`: 用于 uv/pytest 的 Python 版本(与 `.python-version` 保持一致).
python := "3.10"

# `default_index`: 固定默认索引为 PyPI,避免本机全局 uv 配置影响 lock 内容.
default_index := "https://pypi.org/simple"

_default:
  @just --list

# 生成/更新 `uv.lock`.
lock:
  @uv lock -p {{python}} --default-index {{default_index}}

# 按 `uv.lock` 同步虚拟环境(不会改锁文件).
sync:
  @uv sync -p {{python}} --frozen --default-index {{default_index}}

# 运行测试 (需 compose bridge 内 mysql57/mysql8; 由根 justfile test-docker 拉起).
test:
  @cd .. && just test-docker lush-sqlalchemyx

# 分别使用 MySQL 5.7 和 8 运行 datetime None / zero-date 集成测试 (matrix, 跳过覆盖率).
# 需要本机 Docker; CI 可设 LUSH_TEST_MYSQL_PULL=1 自动拉镜像.
test-mysql-matrix:
  @echo "=== MySQL 5.7 (zero-date / none_policy) ==="
  LUSH_TEST_MYSQL_PULL=1 uv run -p {{python}} --default-index {{default_index}} \
    pytest tests/test_mysql_update_none_datetime.py::TestMysql57ZeroDateReproduction -v --tb=short --no-cov
  @echo "=== MySQL 8 (strict / none_policy) ==="
  LUSH_TEST_MYSQL_PULL=1 uv run -p {{python}} --default-index {{default_index}} \
    pytest tests/test_mysql_update_none_datetime.py::TestMysql8StrictNoneDatetime -v --tb=short --no-cov
  @echo "=== Shared mysql_endpoint smoke ==="
  LUSH_TEST_MYSQL_PULL=1 LUSH_TEST_MYSQL_IMAGE=mysql:8.0.40-debian uv run -p {{python}} --default-index {{default_index}} \
    pytest tests/test_mysql_update_none_datetime.py::TestUpdateOnlySetNonePolicy \
           tests/test_mysql_update_none_datetime.py::TestOracleAssignNoneEquivalent \
           tests/test_mysql_container.py -v --tb=short --no-cov

# 运行性能基准测试.
bench:
  @uv run -p {{python}} --default-index {{default_index}} pytest tests/test_benchmark.py --benchmark-only --no-cov -v

# 构建 dist (wheel/sdist).
build:
  @uv build --default-index {{default_index}}

# 清理缓存/构建产物.
clean:
  @rm -rf .venv .pytest_cache .ruff_cache .mypy_cache .coverage .coverage.* dist build *.egg-info
  @find . -type d -name '__pycache__' -prune -exec rm -rf {} +

# 格式化(ruff format).
fmt:
  @uvx --default-index {{default_index}} ruff format

# 类型检查(basedpyright, 含 examples 下游 SSOT 门禁).
typecheck:
  @uvx --default-index {{default_index}} basedpyright --level error
  @echo "--- examples 下游 SSOT 门禁 ---"
  @uvx --default-index {{default_index}} basedpyright examples/

# 类型检查: 仅 examples (下游 SSOT 门禁, 必须 0 error 0 warning).
typecheck-examples:
  @uv run -p {{python}} --default-index {{default_index}} basedpyright examples/

# Lint 检查(ruff check).
lint:
  @uvx --default-index {{default_index}} ruff check

# Lint 并自动修复(ruff check --fix).
lint-fix:
  @uvx --default-index {{default_index}} ruff check --fix

# 读取当前版本号.
version:
  @uv version --short

# 设置版本号(不自动重新 lock).
set-version version:
  @uv version --frozen {{version}}

# 语义化 bump (level: major/minor/patch/alpha/beta/rc/dev/post...).
bump level:
  @uv version --bump {{level}} --frozen
